DB_SERVER=DESKTOP-ABC\SQLEXPRESS
DB_NAME=ERP_G7_v2
DB_USER=sa
DB_PASSWORD=YourPasswordHere

SECRET_KEY=generate_a_long_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=4320

# ========================================================
# SMARTFLOW CHATBOT V2 - MULTI-PROVIDER CONFIGURATION
# ========================================================
# Thứ tự ưu tiên provider (tùy chọn): gemini_api,groq,openrouter,ollama,local_gemini
# Nếu để trống, hệ thống tự động chọn các provider đã có API key (KHÔNG mặc định chạy local_gemini).
CHATBOT_PROVIDER_CHAIN=

# 1. Google Gemini Official API (Khuyến nghị chạy Production)
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
GEMINI_API_MODEL=gemini-2.5-flash

# 2. Groq Cloud API (Miễn phí / Tốc độ cao)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3. OpenRouter API (Tùy chọn)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# 4. Ollama Local (Tùy chọn)
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:14b

# 5. Local Gemini Web To API Proxy (Port 8081 - KHÔNG chạy mặc định)
LOCAL_GEMINI_ENABLED=false
LOCAL_GEMINI_URL=http://localhost:8081/openai/v1/chat/completions
LOCAL_GEMINI_MODEL=gemini-auto
LOCAL_GEMINI_API_KEY=not-needed
# Khóa bảo mật trùng khớp với AI/gemini-web-to-api/.env để cập nhật Cookie nóng (hot-reload) từ Web UI
GEMINI_COOKIE_API_KEY=smartflow_cookie_admin_key_2026
